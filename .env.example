# Copy this file to .env and replace every placeholder.
# Codes are case-sensitive after surrounding whitespace is trimmed.
ROOM_CODE=replace-with-a-long-random-room-code
MODERATOR_CODE=replace-with-a-different-long-random-code
# 32 random bytes, hex encoded. Used only to hash device identifiers and IP addresses.
IDENTITY_SALT=replace-with-a-32-byte-hex-value
# Minimum accepted suggestions before stage 1 can start. Positive integer.
MIN_SUGGESTIONS=10

DB_PATH=/data/naming_pool.db
# Keep true behind Tailscale Funnel (HTTPS).
# Set false only when running locally over plain HTTP.
COOKIE_SECURE=true
